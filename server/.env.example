# Copy to .env and fill in. Values shown are safe local-dev defaults.

# Render Postgres connection string (or any Postgres URL).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Secret used to sign JWTs. Keep this private and stable (changing it
# invalidates all existing login sessions).
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Seeded admin account (created on first boot if it doesn't exist).
ADMIN_EMAIL=admin@homify.co.zw
ADMIN_PASSWORD=change_me

# Frontend origin - used for CORS and for links inside emails.
FRONTEND_URL=http://localhost:3001

# --- Email (SMTP) ------------------------------------------------------------
# Without these, verification/reset emails are NOT sent (register/forgot
# password still work; the API reports emailVerificationSent=false instead of
# silently pretending). Use e.g. Gmail with an App Password, or Mailgun/SendGrid.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM=Homify <you@gmail.com>

# --- Phone OTP (SMS) ---------------------------------------------------------
# 'console' (or unset) = dev only: OTP is logged to the server console and
# returned in the API's debug field. In production, phone sign-in returns 503
# until a real provider is configured - users are never told an SMS was sent
# when it wasn't.
SMS_PROVIDER=console
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# SMS_PROVIDER=africastalking
# AFRICASTALKING_USERNAME=
# AFRICASTALKING_API_KEY=
# AFRICASTALKING_SENDER_ID=Homify

# --- Google Sign-In ----------------------------------------------------------
# OAuth client ID used to verify Google tokens server-side (must match the
# ID in js/auth.js).
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# --- Image storage (Supabase Storage recommended; Cloudinary also supported) ---
# Create a public Storage bucket named "property-images" in your Supabase project.
# Use the Project URL and a server-side service_role key ONLY on the backend.
# Never expose SUPABASE_SERVICE_ROLE_KEY in frontend code or commit its value.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=property-images

# Optional alternative provider if Supabase Storage is not used:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
